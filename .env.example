# Copie ce fichier en .env.local et remplis les valeurs toi-même.
APIFY_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Recherche Google moins chère qu Apify (serper.dev, ~1 $ / 1 000 recherches). Vide = Apify.
SERPER_API_KEY=
# Prix OpenAI du modèle, en $ par million de tokens (page tarifs OpenAI), pour compter le coût IA.
OPENAI_PRIX_ENTREE=
OPENAI_PRIX_SORTIE=
